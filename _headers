# Cache images for 6 months
/_nuxt/img/*.jpg
  Cache-Control: public, max-age=15552000, immutable

/_nuxt/img/*.png
  Cache-Control: public, max-age=15552000, immutable

/_nuxt/img/*.gif
  Cache-Control: public, max-age=15552000, immutable

/_nuxt/img/*.webp
  Cache-Control: public, max-age=15552000, immutable
